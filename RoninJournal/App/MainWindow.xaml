<Window x:Class="RoninJournal.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ronin.1.2 · Ronin Mushrooms Co." Width="1380" Height="900" MinWidth="1100" MinHeight="760" Background="#080F1C" FontFamily="Segoe UI" Foreground="#EDEFE9" WindowStartupLocation="CenterScreen">
 <Grid Background="#080F1C">
  <Grid.ColumnDefinitions><ColumnDefinition Width="234"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0C1626" BorderBrush="#233248" BorderThickness="0,0,1,0">
   <Grid Margin="22,18,22,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Button x:Name="BrandHome" Click="BrandHome_Click" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Ronin Mushrooms Co. — return to Today">
      <Image x:Name="BrandLogo" Source="/RoninJournal;component/Assets/ronin.png" Stretch="Uniform" Height="116" AutomationProperties.Name="Ronin Mushrooms Co. logo"/>
     </Button>
     <TextBlock Text="RONIN.1.2" FontSize="25" FontWeight="SemiBold" Foreground="#B69BF4" Margin="3,12,0,0"/>
     <TextBlock Text="MUSHROOMS CO." FontSize="11" Margin="3,5,0,0" Foreground="#BCCBDE"/>
     <Border Background="#343052" Height="1" Margin="0,18,0,16"/>
     <TextBlock Text="YOUR PRIVATE WORKSPACE" FontSize="10" Foreground="#91A5BF" Margin="3,0,0,14"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
    <StackPanel Grid.Row="2"><Border Background="#132637" CornerRadius="10" Padding="14"><StackPanel><TextBlock Text="●  LOCAL &amp; PERSONAL" Foreground="#7CE9CE" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Your records. Your rhythm." Foreground="#A7B8CE" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border><TextBlock Text="RONIN.1.2  /  JOURNAL" Foreground="#8396B1" FontSize="10" Margin="4,16,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,25,34,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Eyebrow" Text="THE DAILY PRACTICE" Foreground="#69E6E2" FontSize="11"/><TextBlock x:Name="PageTitle" Text="Today" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="DateLabel" HorizontalAlignment="Right" FontSize="14"/><TextBlock Text="Private workspace · independent installation" FontSize="11" Foreground="#A4B3C9" Margin="0,6,0,0"/></StackPanel></Grid>
   <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page" Margin="0,0,12,14"/></ScrollViewer>
   <TextBlock x:Name="Status" Grid.Row="2" Foreground="#A4B3C9" Text="Ready · Stored on this computer" FontSize="12" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
 </Grid>
</Window>
